<?xml version="1.0" encoding="UTF-8"?>
<!-- Loại trừ SpotBugs. Chỉ thêm khi đã hiểu vì sao cảnh báo là dương tính giả; ghi lý do cạnh từng mục. -->
<FindBugsFilter
        xmlns="https://github.com/spotbugs/filter/3.0.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/spotbugs/etc/findbugsfilter.xsd">

    <!-- EI_EXPOSE_REP / EI_EXPOSE_REP2: Spring tiêm bean qua constructor và JPA entity trả về collection
         được Hibernate quản lý — sao chép phòng thủ ở đây phá lazy loading / dirty checking. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- RCN_REDUNDANT_NULLCHECK_OF_NONNULL_VALUE trong mã MapStruct sinh ra: với method một nguồn đối tượng
         (vd. toAdminUserResponse(User, int)) MapStruct viết `if (user == null) return null;` rồi lại
         `if (user != null) {...}`. Mã sinh tự động, không sửa tay được; chỉ loại trừ đúng mẫu này ở lớp *MapperImpl. -->
    <Match>
        <Class name="~com\.localspot\.mapper\..*MapperImpl"/>
        <Bug pattern="RCN_REDUNDANT_NULLCHECK_OF_NONNULL_VALUE"/>
    </Match>
</FindBugsFilter>
