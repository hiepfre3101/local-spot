# Copy sang .env rồi đổi hết giá trị "changeme_*" trước khi chạy `docker compose up`.
# .env không được commit (xem .gitignore).

# MySQL
MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_DATABASE=localspot
MYSQL_USER=localspot
MYSQL_PASSWORD=changeme_app

# RabbitMQ
RABBITMQ_USER=localspot
RABBITMQ_PASSWORD=changeme_mq

# Meilisearch
MEILI_MASTER_KEY=changeme_meili_master_key

# MinIO (tương thích S3 API cho dev)
MINIO_ROOT_USER=localspot
MINIO_ROOT_PASSWORD=changeme_minio

# Cổng nginx khi chạy `docker compose --profile app` (mặc định 8088)
# APP_PORT=8088
