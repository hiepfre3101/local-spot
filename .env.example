# Copy sang .env rồi đổi hết giá trị "changeme_*" trước khi chạy `docker compose up`.
# .env không được commit (xem .gitignore).

# MySQL
MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_DATABASE=localspot
MYSQL_USER=localspot
MYSQL_PASSWORD=changeme_app

# RabbitMQ
RABBITMQ_USER=localspot
RABBITMQ_PASSWORD=changeme_mq

# Meilisearch
MEILI_MASTER_KEY=changeme_meili_master_key

# MinIO (tương thích S3 API cho dev)
MINIO_ROOT_USER=localspot
MINIO_ROOT_PASSWORD=changeme_minio

# Khóa ký JWT (HS256): base64 của ≥ 32 byte ngẫu nhiên — tạo bằng: openssl rand -base64 32
# Bắt buộc khi chạy `docker compose --profile app`; dev trên host có giá trị mặc định nếu bỏ trống.
JWT_SECRET=changeme_jwt_secret_base64

# Gửi mail (profile app / deploy). Bỏ trống → gửi vào Mailpit (http://localhost:8025)
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SMTP_AUTH=true
# MAIL_STARTTLS=true
# MAIL_FROM=LocalSpot <no-reply@example.com>
# APP_PUBLIC_URL=http://localhost:8088

# Kho ảnh khi deploy (profile app). Bỏ trống → MinIO trong compose, URL ảnh http://localhost:9000/localspot
# STORAGE_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# STORAGE_REGION=auto
# STORAGE_BUCKET=localspot
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_PATH_STYLE=false
# STORAGE_PUBLIC_URL=https://img.example.com
# STORAGE_CREATE_BUCKET=false

# Cổng nginx khi chạy `docker compose --profile app` (mặc định 8088)
# APP_PORT=8088
