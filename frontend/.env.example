# Chép thành frontend/.env (không commit). Biến VITE_* nằm trong bundle gửi cho trình duyệt — không đặt bí mật thật.

# Lớp nền bản đồ: key MapTiler gói miễn phí (https://cloud.maptiler.com/account/keys/) — giới hạn theo tên miền
# (localhost, tên miền deploy). Để trống → dùng OSM Đức (không cần key). Xem src/utils/mapTiles.ts.
VITE_MAPTILER_KEY=

# Thay hẳn nhà cung cấp (Leaflet URL template, {s} {z} {x} {y} {r}) — để trống nếu dùng MapTiler / OSM Đức.
# VITE_MAP_TILE_URL=
# VITE_MAP_TILE_URL_DARK=
# VITE_MAP_TILE_ATTRIBUTION=

# Chỉ đường (OSRM) — mặc định máy chủ cộng đồng https://routing.openstreetmap.de (không cần key).
# VITE_ROUTING_URL=
